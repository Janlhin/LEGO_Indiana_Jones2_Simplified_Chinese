# 源码与文档统一按 UTF-8、LF 行尾入库。
# 注意：patch/ 下的 .ps1 会单独强制 CRLF + BOM，见下方。

* text=auto eol=lf

*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.def   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf

# PowerShell：Windows PowerShell 5.1 读取无 BOM 的 .ps1 时会按系统 ANSI
# 代码页解码，脚本里的中文会变成乱码甚至导致语法错误 —— 必须带 UTF-8 BOM。
# BOM 是文件自身的三个字节，git 原样保存（.ps1 不列入 text 属性的编码转换，
# 只固定行尾为 CRLF）。注意：working-tree-encoding 不接受 UTF-8-with-BOM，
# git 会报 "failed to encode ... from UTF-8-with-BOM to UTF-8"，故不可使用。
*.ps1   text eol=crlf

# 二进制（正常情况下不会入库，双保险）
*.dat   binary
*.dll   binary
*.exe   binary
*.png   binary
*.wav   binary
*.ttf   binary
*.otf   binary

# ---- assets/fonts/ 下的白名单文件 ----
# 这些是要**逐字节**打进 DAT 的素材，行尾转换会破坏内容：
#   *.fnt / *.ft2  —— 字体结构，前面是偏移表，后面是裸图集数据，
#                     一个字节的偏移错位整张图就错
#   *.txt          —— 文本索引表，游戏按固定字节偏移定位字符串
# 因此全部标为 -text（不做任何行尾/编码转换，原样入库）。
assets/fonts/*.fnt     -text
assets/fonts/*.ft2     -text
assets/fonts/*.txt     -text
assets/fonts/charset_full.txt -text

# 汉化后的文本表本体：游戏/构建脚本按 UTF-8 with BOM 读取，
# BOM 必须保留，但行尾统一为 LF。
translations/text.csv  text eol=lf
